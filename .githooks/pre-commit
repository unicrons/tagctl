#!/usr/bin/env bash
#
# Pre-commit hook for tagctl
# Uses trufflehog for secrets and golangci-lint for code quality
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "Running pre-commit checks..."
echo ""

FAILED=0

#######################################
# 1. SECRET DETECTION (trufflehog)
#######################################

echo -n "Checking for secrets (trufflehog)... "

if command -v trufflehog >/dev/null 2>&1; then
    # Check only staged changes
    SECRETS_OUTPUT=$(git diff --cached --name-only -z | xargs -0 -I {} trufflehog filesystem {} --no-update --fail 2>&1 || true)

    if echo "$SECRETS_OUTPUT" | grep -q "Found verified result"; then
        echo -e "${RED}FAILED${NC}"
        echo ""
        echo "$SECRETS_OUTPUT"
        echo ""
        echo -e "${RED}Remove secrets before committing!${NC}"
        FAILED=1
    elif echo "$SECRETS_OUTPUT" | grep -q "Found unverified result"; then
        echo -e "${YELLOW}WARNING${NC}"
        echo ""
        echo "  Potential secrets found (unverified):"
        echo "$SECRETS_OUTPUT" | grep -A2 "Found unverified" | head -20
        echo ""
        echo "  Review these findings. If false positives, add to .trufflehog-ignore"
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${YELLOW}SKIPPED${NC} (trufflehog not installed)"
    echo "  Install: brew install trufflehog"
fi

#######################################
# 2. GO FORMAT CHECK
#######################################

echo -n "Checking Go formatting... "

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    UNFORMATTED=$(gofmt -l $STAGED_GO_FILES 2>/dev/null || true)

    if [ -n "$UNFORMATTED" ]; then
        echo -e "${RED}FAILED${NC}"
        echo ""
        echo "  Files need formatting:"
        for file in $UNFORMATTED; do
            echo -e "    ${YELLOW}$file${NC}"
        done
        echo ""
        echo "  Run: make fmt"
        FAILED=1
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK${NC} (no Go files)"
fi

#######################################
# 3. GOLANGCI-LINT
#######################################

echo -n "Running golangci-lint... "

if [ -n "$STAGED_GO_FILES" ]; then
    if command -v golangci-lint >/dev/null 2>&1; then
        LINT_OUTPUT=$(golangci-lint run --new-from-rev=HEAD~1 --fix=false 2>&1 || true)

        if echo "$LINT_OUTPUT" | grep -qE "^[^:]+:[0-9]+:[0-9]+:"; then
            echo -e "${RED}FAILED${NC}"
            echo ""
            echo "$LINT_OUTPUT" | head -30
            echo ""
            FAILED=1
        else
            echo -e "${GREEN}OK${NC}"
        fi
    else
        # Fallback to go vet
        echo -n "(go vet) "
        VET_OUTPUT=$(go vet ./... 2>&1 || true)
        if [ -n "$VET_OUTPUT" ]; then
            echo -e "${RED}FAILED${NC}"
            echo ""
            echo "$VET_OUTPUT"
            FAILED=1
        else
            echo -e "${GREEN}OK${NC}"
        fi
    fi
else
    echo -e "${GREEN}OK${NC} (no Go files)"
fi

#######################################
# 4. BUILD CHECK
#######################################

echo -n "Checking build... "

BUILD_OUTPUT=$(go build ./... 2>&1)
BUILD_STATUS=$?

if [ $BUILD_STATUS -ne 0 ]; then
    echo -e "${RED}FAILED${NC}"
    echo ""
    echo "$BUILD_OUTPUT"
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

#######################################
# 5. TESTS (optional, fast only)
#######################################

echo -n "Running tests... "

TEST_OUTPUT=$(go test -short ./... 2>&1)
TEST_STATUS=$?

if [ $TEST_STATUS -ne 0 ]; then
    echo -e "${RED}FAILED${NC}"
    echo ""
    echo "$TEST_OUTPUT" | tail -20
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

#######################################
# SUMMARY
#######################################

echo ""
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}Pre-commit checks failed!${NC}"
    echo ""
    echo "To skip (not recommended): git commit --no-verify"
    exit 1
else
    echo -e "${GREEN}All checks passed!${NC}"
fi
