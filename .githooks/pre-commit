#!/usr/bin/env bash
#
# Pre-commit hook for tagctl. The checks run on a copy of the tree being
# committed, not on unstaged edits or untracked files.
#

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0

ok() { printf '%bOK%b%s\n' "$GREEN" "$NC" "${1:+ ($1)}"; }

failed() {
    printf '%bFAILED%b\n\n%s\n\n' "$RED" "$NC" "$1"
    FAILED=1
}

HOOK_DIR=$(cd "$(dirname "$0")" && pwd) || exit 1
GIT_DIR_ABS=$(git rev-parse --absolute-git-dir) || exit 1
# A fixed path keeps the Go build and lint caches warm between commits.
SNAPSHOT="$GIT_DIR_ABS/tagctl-pre-commit"
SNAPSHOT_INDEX="$SNAPSHOT.index"
PATCH="$SNAPSHOT.patch"

cleanup() { rm -rf "$SNAPSHOT" "$SNAPSHOT_INDEX" "$PATCH"; }
trap cleanup EXIT
cleanup

# write-tree leaves out intent-to-add paths (git add -N), which the index
# holds as empty files that do not compile.
TREE=$(git write-tree) || exit 1
GIT_INDEX_FILE="$SNAPSHOT_INDEX" git read-tree "$TREE" || exit 1
GIT_INDEX_FILE="$SNAPSHOT_INDEX" git checkout-index --all --prefix="$SNAPSHOT/" || exit 1

if git rev-parse --verify -q HEAD >/dev/null; then
    BASE=HEAD
    git diff --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ HEAD "$TREE" >"$PATCH" || exit 1
else
    BASE=$(git hash-object -t tree /dev/null)
fi

staged=()
go_files=()
while IFS= read -r -d '' file; do
    staged+=("$file")
    [[ $file == *.go ]] && go_files+=("$file")
done < <(git diff --name-only -z --diff-filter=ACMRT "$BASE" "$TREE")

LINT_BIN_DIR=$(go env GOBIN)
[ -n "$LINT_BIN_DIR" ] || LINT_BIN_DIR="$(go env GOPATH)/bin"
LINT="$LINT_BIN_DIR/golangci-lint"
[ -x "$LINT" ] || LINT=$(command -v golangci-lint)

cd "$SNAPSHOT" || exit 1

echo "Running pre-commit checks..."
echo ""

#######################################
# 1. SECRET DETECTION (trufflehog)
#######################################

# The staged script, so it agrees with the staged .trufflehog-ignore.
SECRETS_CHECK=./.githooks/check-secrets.sh
[ -x "$SECRETS_CHECK" ] || SECRETS_CHECK="$HOOK_DIR/check-secrets.sh"

if [ "${#staged[@]}" -gt 0 ]; then
    "$SECRETS_CHECK" "${staged[@]}" || FAILED=1
else
    printf 'Checking for secrets (trufflehog)... '
    ok "no staged files"
fi

#######################################
# 2. GO FORMAT CHECK
#######################################

printf 'Checking Go formatting... '

if [ "${#go_files[@]}" -eq 0 ]; then
    ok "no Go files"
else
    UNFORMATTED=$(gofmt -l "${go_files[@]}" 2>&1)
    if [ -n "$UNFORMATTED" ]; then
        failed "$(printf 'Files need formatting:\n%s\n\nRun: make fmt' "$UNFORMATTED")"
    else
        ok
    fi
fi

#######################################
# 3. GOLANGCI-LINT
#######################################

printf 'Running golangci-lint... '

if [ "${#go_files[@]}" -eq 0 ]; then
    ok "no Go files"
elif [ -n "$LINT" ]; then
    # Without a HEAD (first commit) every issue is new, so the whole tree is linted.
    LINT_ARGS=(run --allow-serial-runners)
    [ -f "$PATCH" ] && LINT_ARGS+=("--new-from-patch=$PATCH")
    if LINT_OUTPUT=$("$LINT" "${LINT_ARGS[@]}" ./... 2>&1); then
        ok
    else
        failed "$(printf '%s\n' "$LINT_OUTPUT" | head -30)"
    fi
else
    printf '%b(go vet, golangci-lint not installed: make tools)%b ' "$YELLOW" "$NC"
    if VET_OUTPUT=$(go vet ./... 2>&1); then
        ok
    else
        failed "$VET_OUTPUT"
    fi
fi

#######################################
# 4. BUILD CHECK
#######################################

printf 'Checking build... '

# The snapshot lives inside the git directory, where VCS stamping finds no work tree.
if BUILD_OUTPUT=$(go build -buildvcs=false ./... 2>&1); then
    ok
else
    failed "$BUILD_OUTPUT"
fi

#######################################
# 5. TESTS (short)
#######################################

printf 'Running tests... '

if TEST_OUTPUT=$(go test -short ./... 2>&1); then
    ok
else
    failed "$(printf '%s\n' "$TEST_OUTPUT" | grep -Ev '^(ok|\?) ' | head -40)"
fi

#######################################
# SUMMARY
#######################################

echo ""
if [ "$FAILED" -eq 1 ]; then
    printf '%bPre-commit checks failed!%b\n\n' "$RED" "$NC"
    echo "To skip (not recommended): git commit --no-verify"
    exit 1
fi
printf '%bAll checks passed!%b\n' "$GREEN" "$NC"
