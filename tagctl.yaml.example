# tagctl configuration
# See https://github.com/unicrons/tagctl for documentation

# Cloud accounts to scan
clouds:
  aws:
    # Credentials come from the AWS SDK chain: environment variables, then
    # ~/.aws/config and ~/.aws/credentials (profiles, SSO), then an instance
    # or container role. Keys are never read from this file.
    # If regions is omitted, all available regions will be scanned
    - profile: default
      # regions:
      #   - us-east-1
      #   - eu-west-1

    # Or omit profile to use whatever the chain resolves: AWS_PROFILE,
    # exported AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN,
    # an active SSO session or an instance role.
    # - regions: [us-east-1]

    # Or assume a role on top of the resolved credentials, one entry per
    # account. Only role_arn is required.
    # - profile: audit-base
    #   role_arn: arn:aws:iam::123456789012:role/TagctlScan   # permissions/aws/ ships the role templates
    #   external_id: my-external-id
    #   session_duration: 3600          # 900-43200 seconds, default 3600
    #   role_session_name: tagctl
    #   mfa_serial: arn:aws:iam::111111111111:mfa/me   # TOTP code read from stdin
    #   regions: [us-east-1]

  # Kubernetes clusters: labels are the tags. See docs/providers/kubernetes.mdx
  # for the resource types, RBAC and the limits of label values (no e-mails).
  # kubernetes:
  #   - name: production            # unique; the account of its resources
  #     kubeconfig: ~/.kube/config  # or in-cluster; omitted: KUBECONFIG, then ~/.kube/config
  #     context: prod-context       # omitted: the current context
  #     namespaces: [app, backend]  # omitted: the whole cluster
  #     resource_types: [k8s_deployment, k8s_service]   # omitted: all but k8s_secret

  # gcp and azure are reserved keys: accepted and ignored. Provider status:
  # docs/development.mdx

# Tag policy definition
policy:
  # Required tags - resources without these are non-compliant
  required:
    - name: environment
      description: Deployment environment
      values:
        - dev
        - staging
        - prod

    - name: cost-center
      description: Finance cost allocation code
      pattern: "^[A-Z]{2,4}-\\d{3,6}$"

    - name: owner
      description: Team or person responsible
      pattern: "^.+@.+$"

  # Optional tags - tracked but not required
  optional:
    - name: project
    - name: team

  # Forbidden tags - a resource carrying one is non-compliant and
  # 'tagctl plan' proposes removing it
  # forbidden:
  #   - name: Env                  # the key itself
  #   - name: environment          # or only some values
  #     values: [test]
  #   - name: owner
  #     pattern: "^(unknown|tbd)"

# Auto-fix rules
rules:
  # Infer tags from resource naming conventions
  infer:
    - tag: environment
      # From another tag on the same resource, tried before from_name
      # from_tag:
      #   - tag: env
      #     values:              # optional: without it the value is copied
      #       production: prod
      from_name:
        - pattern: "-prod-"
          value: prod
        - pattern: "-staging-|-stg-"
          value: staging
        - pattern: "-dev-"
          value: dev

  # Inherit tags from parent resources
  # inherit:
  #   - resource: aws_ebs_volume
  #     from: attached_instance   # or source_volume, vpc
  #     tags: [environment, cost-center, owner]

  # Rename a tag key: adds the new key with the old value, removes the old key.
  # Skipped as a conflict when the new key already holds another value
  # rename:
  #   - from: Env
  #     to: environment

  # Default values for untagged resources
  defaults:
    - resource: "*"
      when:
        tag:owner: absent
      set:
        owner: platform-team@company.com
        needs-review: "true"

# Resources to ignore
ignore:
  # Skip these resource types
  resources:
    - "aws_cloudwatch_*"
    - "aws_iam_*"

  # Skip resources with these tags
  tags:
    managed-by: [terraform, pulumi]

# Tag value drift detection, used by 'tagctl normalize'.
# Finds values that mean the same thing but are spelled differently, such as
# prod / Production / PROD, which silently split any cost report grouped by
# that tag.
normalize:
  # Edit distance under which two values are treated as a typo of each other,
  # capped at one edit per 3 letters or digits of the shorter value. Values
  # with different digits never match. 0 disables typo matching. Default: 1
  max_distance: 1

  # Group a value with a longer one it is a prefix of ("prod" / "production").
  # Default: true
  match_abbreviations: true

  # Tag keys to leave alone. The Name tag is always ignored, since its values
  # are unique per resource by design.
  ignore_tags:
    - build-id
