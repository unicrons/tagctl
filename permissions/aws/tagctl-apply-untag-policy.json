{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServiceUntagAPIs",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteTags",
        "rds:RemoveTagsFromResource",
        "lambda:UntagResource",
        "sns:UntagResource",
        "sqs:UntagQueue",
        "elasticloadbalancing:RemoveTags",
        "autoscaling:DeleteTags",
        "dynamodb:UntagResource",
        "ecs:UntagResource",
        "eks:UntagResource",
        "elasticache:RemoveTagsFromResource",
        "elasticfilesystem:UntagResource",
        "ecr:UntagResource",
        "kms:UntagResource",
        "kinesis:RemoveTagsFromStream",
        "logs:UntagResource",
        "lightsail:UntagResource",
        "globalaccelerator:UntagResource"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:*::snapshot/*",
        "arn:aws:ec2:*:*:launch-template/*",
        "arn:aws:ec2:*:*:security-group/*",
        "arn:aws:ec2:*:*:vpc/*",
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:internet-gateway/*",
        "arn:aws:ec2:*:*:natgateway/*",
        "arn:aws:ec2:*:*:vpc-endpoint/*",
        "arn:aws:ec2:*:*:elastic-ip/*",
        "arn:aws:rds:*:*:db:*",
        "arn:aws:rds:*:*:cluster:*",
        "arn:aws:rds:*:*:snapshot:*",
        "arn:aws:lambda:*:*:function:*",
        "arn:aws:sns:*:*:*",
        "arn:aws:sqs:*:*:*",
        "arn:aws:elasticloadbalancing:*:*:loadbalancer/*",
        "arn:aws:elasticloadbalancing:*:*:targetgroup/*",
        "arn:aws:autoscaling:*:*:autoScalingGroup:*:autoScalingGroupName/*",
        "arn:aws:dynamodb:*:*:table/*",
        "arn:aws:ecs:*:*:cluster/*",
        "arn:aws:ecs:*:*:service/*",
        "arn:aws:eks:*:*:cluster/*",
        "arn:aws:elasticache:*:*:cluster:*",
        "arn:aws:elasticfilesystem:*:*:file-system/*",
        "arn:aws:ecr:*:*:repository/*",
        "arn:aws:kms:*:*:key/*",
        "arn:aws:kinesis:*:*:stream/*",
        "arn:aws:logs:*:*:log-group:*",
        "arn:aws:lightsail:*:*:Instance/*",
        "arn:aws:globalaccelerator::*:accelerator/*"
      ]
    },
    {
      "Sid": "UntaggingAPI",
      "Effect": "Allow",
      "Action": [
        "tag:UntagResources",
        "workspaces:DeleteTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UntaggingAPIServices",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:RemoveTags",
        "apigateway:DELETE",
        "cloudfront:UntagResource",
        "fsx:UntagResource",
        "backup:UntagResource",
        "redshift:DeleteTags",
        "es:RemoveTags",
        "firehose:UntagDeliveryStream",
        "kafka:UntagResource",
        "glue:UntagResource",
        "sagemaker:DeleteTags",
        "events:UntagResource",
        "states:UntagResource",
        "cognito-idp:UntagResource",
        "cloudwatch:UntagResource",
        "cloudformation:UntagResource",
        "secretsmanager:UntagResource",
        "acm:RemoveTagsFromCertificate",
        "iam:UntagRole",
        "access-analyzer:UntagResource",
        "acm-pca:UntagCertificateAuthority",
        "cloudtrail:RemoveTags",
        "config:UntagResource",
        "ds:RemoveTagsFromResource",
        "fms:UntagResource",
        "guardduty:UntagResource",
        "network-firewall:UntagResource",
        "rolesanywhere:UntagResource",
        "waf-regional:UntagResource",
        "waf:UntagResource",
        "wafv2:UntagResource",
        "shield:UntagResource",
        "amplify:UntagResource",
        "appsync:UntagResource",
        "bedrock:UntagResource",
        "codeartifact:UntagResource",
        "codecommit:UntagResource",
        "codepipeline:UntagResource",
        "wellarchitected:UntagResource",
        "athena:UntagResource",
        "dms:RemoveTagsFromResource",
        "datapipeline:RemoveTags",
        "datasync:UntagResource",
        "elasticmapreduce:RemoveTags",
        "glacier:RemoveTagsFromVault",
        "memorydb:UntagResource",
        "mq:DeleteTags",
        "ses:UntagResource",
        "storagegateway:RemoveTagsFromResource",
        "transfer:UntagResource",
        "appstream:UntagResource",
        "batch:UntagResource",
        "directconnect:UntagResource",
        "dlm:UntagResource",
        "drs:UntagResource",
        "ssm:RemoveTagsFromResource",
        "ssm-incidents:UntagResource"
      ],
      "Resource": [
        "arn:aws:elasticbeanstalk:*:*:environment/*",
        "arn:aws:apigateway:*::/tags/*",
        "arn:aws:cloudfront::*:distribution/*",
        "arn:aws:fsx:*:*:file-system/*",
        "arn:aws:backup:*:*:backup-vault:*",
        "arn:aws:redshift:*:*:cluster:*",
        "arn:aws:es:*:*:domain/*",
        "arn:aws:firehose:*:*:deliverystream/*",
        "arn:aws:kafka:*:*:cluster/*",
        "arn:aws:glue:*:*:job/*",
        "arn:aws:sagemaker:*:*:endpoint/*",
        "arn:aws:sagemaker:*:*:notebook-instance/*",
        "arn:aws:events:*:*:rule/*",
        "arn:aws:states:*:*:stateMachine:*",
        "arn:aws:cognito-idp:*:*:userpool/*",
        "arn:aws:cloudwatch:*:*:alarm:*",
        "arn:aws:cloudformation:*:*:stack/*",
        "arn:aws:secretsmanager:*:*:secret:*",
        "arn:aws:acm:*:*:certificate/*",
        "arn:aws:iam::*:role/*",
        "arn:aws:access-analyzer:*:*:analyzer/*",
        "arn:aws:acm-pca:*:*:certificate-authority/*",
        "arn:aws:cloudtrail:*:*:trail/*",
        "arn:aws:config:*:*:config-rule/*",
        "arn:aws:ds:*:*:directory/*",
        "arn:aws:fms:*:*:policy/*",
        "arn:aws:guardduty:*:*:detector/*",
        "arn:aws:network-firewall:*:*:firewall/*",
        "arn:aws:rolesanywhere:*:*:trust-anchor/*",
        "arn:aws:waf-regional:*:*:webacl/*",
        "arn:aws:waf::*:webacl/*",
        "arn:aws:wafv2:*:*:*/webacl/*",
        "arn:aws:shield::*:protection/*",
        "arn:aws:amplify:*:*:apps/*",
        "arn:aws:appsync:*:*:apis/*",
        "arn:aws:bedrock:*:*:guardrail/*",
        "arn:aws:codeartifact:*:*:domain/*",
        "arn:aws:codeartifact:*:*:repository/*",
        "arn:aws:codecommit:*:*:*",
        "arn:aws:codepipeline:*:*:*",
        "arn:aws:wellarchitected:*:*:workload/*",
        "arn:aws:athena:*:*:workgroup/*",
        "arn:aws:dms:*:*:rep:*",
        "arn:aws:datapipeline:*:*:pipeline/*",
        "arn:aws:datasync:*:*:task/*",
        "arn:aws:elasticmapreduce:*:*:cluster/*",
        "arn:aws:glacier:*:*:vaults/*",
        "arn:aws:memorydb:*:*:cluster/*",
        "arn:aws:mq:*:*:broker:*",
        "arn:aws:ses:*:*:identity/*",
        "arn:aws:ses:*:*:configuration-set/*",
        "arn:aws:storagegateway:*:*:gateway/*",
        "arn:aws:transfer:*:*:server/*",
        "arn:aws:appstream:*:*:fleet/*",
        "arn:aws:appstream:*:*:stack/*",
        "arn:aws:batch:*:*:compute-environment/*",
        "arn:aws:batch:*:*:job-queue/*",
        "arn:aws:directconnect:*:*:dxcon/*",
        "arn:aws:dlm:*:*:policy/*",
        "arn:aws:drs:*:*:source-server/*",
        "arn:aws:ssm:*:*:parameter/*",
        "arn:aws:ssm:*:*:document/*",
        "arn:aws:ssm-incidents::*:response-plan/*"
      ]
    }
  ]
}
